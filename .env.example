# Configurazione del sito (Astro).
# Copia questo file in ".env" e compila i valori.
#
# ATTENZIONE alla differenza:
# - projectId e dataset NON sono segreti. Servono a leggere contenuti già
#   pubblici e possono stare qui.
# - Un token Sanity con permessi di scrittura È un segreto. Non deve stare in
#   nessun file .env versionabile, non deve avere prefisso PUBLIC_ e non deve
#   mai finire nel codice del sito. Sta solo nei "secrets" di GitHub Actions.

# Identificativo del progetto Sanity, da sanity.io/manage
SANITY_PROJECT_ID=

# Quasi sempre "production"
SANITY_DATASET=production

# Indirizzo definitivo del sito, senza barra finale.
# Serve per canonical, sitemap e anteprime social: se è sbagliato, i link
# condivisi su WhatsApp puntano nel posto sbagliato.
SITO_URL=https://www.alessandromanuntacoltelli.it
