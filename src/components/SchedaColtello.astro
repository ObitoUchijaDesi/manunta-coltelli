---
import type {Coltello, ImpostazioniSito} from '../lib/tipi'
import {ETICHETTE_DISPONIBILITA} from '../lib/tipi'
import {urlWhatsApp, messaggi} from '../lib/contatti'
import FotoColtello from './FotoColtello.astro'
import {LARGHEZZE_SCHEDA} from '../lib/immagini'

interface Props {
  coltello: Coltello
  impostazioni: ImpostazioniSito
  /** Vero per le prime schede: la loro foto non va rimandata. */
  prioritaria?: boolean
}

const {coltello, impostazioni, prioritaria = false} = Astro.props

const href = `/coltelli/${coltello.slug}/`
const whatsapp = urlWhatsApp(impostazioni, messaggi.perColtello(coltello, Astro.site))
---

<article class="knife-card">
  {coltello.pezzoUnico && <span class="knife-badge">Pezzo unico</span>}

  <span
    class={coltello.disponibilita === 'disponibile' ? 'knife-availability' : 'knife-availability off'}
  >
    {ETICHETTE_DISPONIBILITA[coltello.disponibilita]}
  </span>

  <div class="knife-card-media" data-inclina>
    {/* La cornice ritaglia: la fotografia dentro e' ingrandita e deriva con lo
        scorrimento, e senza ritaglio uscirebbe sopra il testo della scheda.
        Sta dentro .knife-card-media e non al suo posto perche' il pallino
        WhatsApp sporge sotto il bordo di proposito: se ritagliassimo il
        contenitore esterno lo taglieremmo a meta'. */}
    <div class="knife-card-cornice">
      <FotoColtello
        immagine={coltello.immaginePrincipale}
        nomeColtello={coltello.nome}
        larghezze={LARGHEZZE_SCHEDA}
        sizes="(max-width: 560px) 92vw, (max-width: 1000px) 45vw, 30vw"
        prioritaria={prioritaria}
        class="knife-card-img"
      />
    </div>

    {
    /* Il pallino sta sopra la fotografia, fuori dal link della scheda: è un
       secondo percorso, non un dettaglio del primo. Se il numero non c'è
       nel pannello, non viene disegnato nulla. */
    whatsapp && (
      <a
        class="knife-wa-pallino"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Chiedi informazioni su ${coltello.nome} via WhatsApp`}
        title="Chiedi informazioni su WhatsApp"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span class="knife-wa-testo">Chiedi info</span>
        </a>
      )
    }
  </div>

  <div class="knife-card-body">
    <h3 class="knife-name">
      <a href={href} class="knife-name-link">{coltello.nome}</a>
    </h3>

    {coltello.descrizioneBreve && <p class="knife-short">{coltello.descrizioneBreve}</p>}

    {/* Non è un link: tutta la scheda lo è già. Resta come segnale visivo
        che qui si può entrare, e la freccia si sposta al passaggio. */}
    <div class="knife-actions">
      <span class="knife-detail-btn" aria-hidden="true">
        Scopri <span class="knife-freccia">&rarr;</span>
      </span>
    </div>
  </div>
</article>

<style>
  /* Tutta la scheda è cliccabile.
     Il collegamento vero è uno solo — quello sul nome — e si allarga a
     coprire l'intera scheda con uno pseudo-elemento. Così il bersaglio è
     grande quanto la scheda, ma chi usa uno screen reader sente un unico
     collegamento chiamato col nome del coltello, invece di tre che portano
     tutti nello stesso posto. */
  .knife-name-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* "Scopri" non è più un link: è un'indicazione. La freccia si sposta
     quando il dito o il mouse sono sulla scheda. */
  .knife-detail-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
  }

  .knife-freccia {
    transition: transform 0.3s ease;
  }

  .knife-card:hover .knife-freccia {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .knife-freccia {
      transition: none;
    }
  }

  /* Contenitore della fotografia: serve solo ad ancorare il pallino. */
  .knife-card-media {
    position: relative;
  }

  /* Ritaglia la deriva della fotografia. Il rapporto sta qui e non
     sull'immagine, cosi' l'altezza della scheda non dipende da quanto
     l'immagine viene ingrandita per derivare. */
  .knife-card-cornice {
    /* clip-path e non overflow:hidden: overflow renderebbe la cornice un
       contenitore di scorrimento, e la deriva della fotografia (che usa
       animation-timeline: view()) si misurerebbe su una cornice che non
       scorre mai, restando ferma. */
    clip-path: inset(0);
    aspect-ratio: 4 / 3;
  }

  :global(.knife-card-cornice .knife-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Il pallino WhatsApp, appoggiato sul bordo basso della fotografia.
     Verde di WhatsApp perché deve essere riconosciuto in mezzo secondo:
     è il punto in cui questo sito smette di essere una vetrina e diventa
     una conversazione. */
  .knife-wa-pallino {
    position: absolute;
    right: 1rem;
    bottom: -22px;
    z-index: 3;

    display: inline-flex;
    align-items: center;
    gap: 0;
    min-width: 52px;
    height: 52px;
    padding: 0 15px;
    box-sizing: border-box;

    background: #25d366;
    color: #04301a;
    border: 3px solid var(--bg2);
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);

    overflow: hidden;
    white-space: nowrap;
    transition: gap 0.32s ease, padding 0.32s ease, background 0.25s, transform 0.25s;
  }

  .knife-wa-testo {
    max-width: 0;
    opacity: 0;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: max-width 0.32s ease, opacity 0.22s ease;
  }

  /* Su schermi con mouse la pillola si apre e mostra l'invito.
     Su telefono resta un pallino, che è già chiarissimo. */
  @media (hover: hover) {
    .knife-card:hover .knife-wa-pallino,
    .knife-wa-pallino:focus-visible {
      gap: 0.55rem;
      padding: 0 20px;
      background: #2ee477;
    }

    .knife-card:hover .knife-wa-testo,
    .knife-wa-pallino:focus-visible .knife-wa-testo {
      max-width: 8rem;
      opacity: 1;
    }
  }

  .knife-wa-pallino:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .knife-wa-pallino,
    .knife-wa-testo {
      transition: none;
    }
  }

</style>
