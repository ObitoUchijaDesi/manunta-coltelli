---
import FotoColtello from './FotoColtello.astro'
import {LARGHEZZE_DETTAGLIO} from '../lib/immagini'
import {ETICHETTE_CATEGORIA} from '../lib/tipi'
import type {Coltello} from '../lib/tipi'

/**
 * Un coltello solo, fra la biografia e il catalogo.
 *
 * La fotografia resta ferma mentre le sue caratteristiche scorrono accanto: e'
 * il modo in cui si guarda un oggetto tenendolo in mano — l'oggetto sta
 * fermo, gli occhi girano intorno ai dettagli. Lo fa `position: sticky`, cioe'
 * il browser, senza JavaScript e senza rubare lo scorrimento: la pagina
 * scorre normalmente, e' solo un elemento che resta al suo posto.
 *
 * Perche' questa versione e non le due precedenti.
 *
 * La prima riempiva una fascia a tutta pagina con la fotografia ritagliata:
 * su una foto verticale il ritaglio centrale lasciava fuori il coltello.
 *
 * La seconda metteva due coltelli in due blocchi uguali, con l'etichetta
 * "Dalla bottega". Due difetti veri: l'etichetta non diceva niente, e i due
 * blocchi ripetevano il catalogo che sta poche centinaia di pixel sotto —
 * lo stesso coltello grande e poi di nuovo in griglia. Una sezione che
 * duplica invece di aggiungere e' peggio di una sezione che manca.
 *
 * Qui non si ripete niente: il catalogo mostra i coltelli, questa sezione
 * mostra COM'E' FATTO uno. Le caratteristiche — acciaio, manico, misure, anno
 * — vivevano solo nella pagina di dettaglio, dove arriva chi ha gia' deciso
 * di guardare.
 *
 * Nessun testo scritto qui dentro: nome, descrizione e caratteristiche
 * arrivano da Sanity, e ogni riga esiste solo se il campo e' compilato. Un
 * coltello di cui si conosce il solo nome produce una sezione piu' corta, non
 * un elenco di voci vuote.
 */

interface Props {
  coltello: Coltello
}

const {coltello} = Astro.props

const caratteristiche = [
  {voce: 'Tipo', valore: coltello.categoria ? ETICHETTE_CATEGORIA[coltello.categoria] : ''},
  {voce: 'Lama', valore: coltello.materialeLama ?? ''},
  {voce: 'Manico', valore: coltello.materialeManico ?? ''},
  {voce: 'Altri materiali', valore: coltello.altriMateriali ?? ''},
  {
    voce: 'Lunghezza totale',
    valore: typeof coltello.lunghezzaTotale === 'number' ? `${coltello.lunghezzaTotale} cm` : '',
  },
  {
    voce: 'Lunghezza lama',
    valore: typeof coltello.lunghezzaLama === 'number' ? `${coltello.lunghezzaLama} cm` : '',
  },
  {voce: 'Anno', valore: coltello.anno ? String(coltello.anno) : ''},
].filter((c) => c.valore.trim())
---

<section class="pezzo" aria-labelledby="titolo-pezzo">
  <div class="pezzo-griglia">
    <div class="pezzo-foto">
      <FotoColtello
        immagine={coltello.immaginePrincipale}
        nomeColtello={coltello.nome}
        larghezze={LARGHEZZE_DETTAGLIO}
        sizes="(max-width: 900px) 92vw, 48vw"
        class="pezzo-immagine"
      />
    </div>

    <div class="pezzo-dati">
      <h2 class="pezzo-nome" id="titolo-pezzo">{coltello.nome}</h2>

      {coltello.pezzoUnico && <p class="pezzo-unico">Pezzo unico</p>}

      {coltello.descrizioneBreve && <p class="pezzo-riga">{coltello.descrizioneBreve}</p>}

      {
        caratteristiche.length > 0 && (
          <dl class="pezzo-elenco">
            {caratteristiche.map((c) => (
              <div class="pezzo-voce">
                <dt>{c.voce}</dt>
                <dd>{c.valore}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <a href={`/coltelli/${coltello.slug}/`} class="btn-gold pezzo-azione">
        Guarda {coltello.nome}
      </a>
    </div>
  </div>
</section>

<style>
  .pezzo {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: clamp(4.5rem, 10vw, 9rem) 2rem;
  }

  .pezzo-griglia {
    max-width: 1220px;
    margin: 0 auto;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5.5rem);
  }

  /* :global perche' l'<img> lo produce FotoColtello e porta l'ambito di QUEL
     componente: una regola normale non lo raggiunge, e senza height:auto
     l'attributo height dell'immagine diventa un'altezza CSS da migliaia di
     pixel. Trappola numero due di docs/TRAPPOLE.md, presa in pieno una volta
     scrivendo questa stessa sezione. */
  :global(.pezzo-immagine) {
    width: 100%;
    height: auto;
    /* Intera, senza ritaglio: non si puo' sapere dove stia la lama nelle
       fotografie che Alessandro caricherà in futuro. */
    object-fit: contain;
    display: block;
  }

  .pezzo-nome {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0;
  }

  .pezzo-unico {
    margin: 1.4rem 0 0;
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(201, 168, 76, 0.4);
    padding: 0.4rem 0.9rem;
  }

  .pezzo-riga {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin: 1.8rem 0 0;
    max-width: 36rem;
  }

  /* Le caratteristiche come righe di un registro, non come tabella: una riga
     d'oro sottile che le separa e le allinea. */
  .pezzo-elenco {
    margin: 2.8rem 0 0;
    max-width: 36rem;
  }

  .pezzo-voce {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--border);
  }

  .pezzo-voce dt {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }

  .pezzo-voce dd {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    text-align: right;
  }

  .pezzo-azione {
    margin-top: 2.8rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 900px) {
    .pezzo-griglia {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      /* Serve una corsa da percorrere, altrimenti l'elemento fermo non ha
         niente da cui restare fermo. Con tre caratteristiche compilate la
         colonna dei dati e' alta 400 pixel: piu' corta della finestra, e la
         fotografia non si "ancora" mai perche' la sezione passa tutta intera
         in una schermata.

         Non e' spazio messo per riempire: e' la corsa lungo la quale le
         caratteristiche entrano una dopo l'altra. Se un coltello ne ha sette
         la colonna e' piu' alta di così e questo minimo non conta. */
      min-height: min(115vh, 1000px);
      /* Nessun align-content: center. Centrarla annullerebbe il minimo qui
         sopra — la riga verrebbe centrata invece di allungarsi, e un elemento
         fermo puo' muoversi solo dentro la propria area di griglia. Con lo
         stiramento predefinito la riga riempie l'altezza e la fotografia ha
         una corsa vera. */
    }

    /* La fotografia resta ferma mentre le caratteristiche scorrono.
       position: sticky e non JavaScript: la pagina scorre come sempre, non le
       viene rubato il controllo. Il valore di top lascia passare la barra in
       alto, che e' fissa. */
    .pezzo-foto {
      position: sticky;
      top: 7rem;
    }

    :global(.pezzo-immagine) {
      max-height: calc(100vh - 11rem);
      margin: 0 auto;
    }
  }

  /* Sotto i 900px niente elemento fermo: su uno schermo alto 600 pixel una
     fotografia bloccata occuperebbe tutto e le caratteristiche scorrerebbero
     in una fessura. Fotografia sopra, dati sotto. */
  @media (max-width: 620px) {
    .pezzo {
      padding: 4rem 1.5rem;
    }

    .pezzo-voce {
      padding: 0.85rem 0;
    }
  }

  /* ── ARRIVI SFALSATI ─────────────────────────────────────
     La fotografia entra per prima; poi il nome, la descrizione e una a una le
     caratteristiche. Legato allo scorrimento, non a un timer: fermandosi a
     metà l'effetto sta a metà, e tornando su torna indietro.

     Proprietà scritte per esteso, mai la scorciatoia "animation": dentro
     quella, animation-timeline viene scartato e non si anima niente. */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pezzo-nome,
      .pezzo-unico,
      .pezzo-riga,
      .pezzo-voce,
      .pezzo-azione {
        animation-name: pezzoEntra;
        animation-timing-function: cubic-bezier(0.16, 0.84, 0.24, 1);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 8% cover 26%;
      }

      /* Le righe delle caratteristiche entrano una dopo l'altra: ognuna ha la
         propria timeline, quindi lo sfalsamento nasce dalla posizione e non da
         un ritardo inventato. Restano allineate anche se un coltello ha due
         caratteristiche e un altro sette. */
      .pezzo-voce {
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes pezzoEntra {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
