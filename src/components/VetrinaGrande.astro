---
import FotoColtello from './FotoColtello.astro'
import {LARGHEZZE_DETTAGLIO} from '../lib/immagini'
import type {Coltello} from '../lib/tipi'

/**
 * I primi coltelli, grandi quanto lo schermo, fra la biografia e il catalogo.
 *
 * Serve a due cose che la home non faceva.
 *
 * La prima: mostrare il lavoro. L'apertura porta il logo e una scritta, e il
 * primo coltello arrivava solo dentro una griglia di schede piccole — un sito
 * che vende oggetti fatti a mano dovrebbe far vedere l'oggetto prima di
 * parlarne.
 *
 * La seconda: il ritmo. La home era apertura grande, poi solo blocchi di
 * testo e una griglia. Nei siti che funzionano i momenti ampi si alternano a
 * quelli informativi: senza alternanza un sito tutto emotivo diventa vago e
 * uno tutto informativo diventa un catalogo a stampa.
 *
 * NIENTE CAROSELLO. Un coltello che cambia da solo obbliga chi guarda a
 * inseguirlo, e chi arriva mentre cambia perde quello di prima: nessuno dei
 * due coltelli ha davvero la priorita'. Qui i coltelli stanno uno sotto
 * l'altro e scorrono con la pagina, che e' il movimento che il visitatore
 * comanda. La fotografia cambia lato a ogni blocco, cosi' il secondo non
 * sembra una ripetizione del primo.
 *
 * QUALE COLTELLO: lo decide Alessandro con il campo "Ordine nel catalogo" che
 * c'e' gia' nel pannello — numero piu' basso, compare prima. Non serve un
 * campo nuovo da spiegargli, e non c'e' niente di casuale: se sceglie un
 * ordine, quello e' l'ordine.
 *
 * Tutto quello che si legge qui viene da Sanity. Non c'e' un testo di questa
 * sezione da mantenere aggiornato, e se il catalogo e' vuoto non viene
 * disegnato niente.
 */

interface Props {
  coltelli: Coltello[]
}

const {coltelli} = Astro.props
---

{
  coltelli.map((coltello, i) => (
    <section
      class="vetrina"
      aria-labelledby={`titolo-vetrina-${coltello.slug}`}
      data-lato={i % 2 === 0 ? 'foto-prima' : 'foto-dopo'}
    >
      <div class="vetrina-griglia">
        <div class="vetrina-foto">
          <FotoColtello
            immagine={coltello.immaginePrincipale}
            nomeColtello={coltello.nome}
            larghezze={LARGHEZZE_DETTAGLIO}
            sizes="(max-width: 900px) 92vw, 46vw"
            class="vetrina-immagine"
          />
        </div>

        <div class="vetrina-testo">
          <p class="vetrina-etichetta">Dalla bottega</p>
          <h2 class="vetrina-nome" id={`titolo-vetrina-${coltello.slug}`}>
            {coltello.nome}
          </h2>
          {coltello.descrizioneBreve && <p class="vetrina-riga">{coltello.descrizioneBreve}</p>}
          <a href={`/coltelli/${coltello.slug}/`} class="btn-gold vetrina-azione">
            Guarda questo coltello
          </a>
        </div>
      </div>
    </section>
  ))
}

<style>
  .vetrina {
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    padding: clamp(4rem, 9vw, 7.5rem) 2rem;
  }

  /* Il bordo in cima a tutti tranne che a chi segue un'altra vetrina: fra due
     blocchi consecutivi due righe attaccate si vedono come un difetto.

     Non :first-of-type, che era la scelta ovvia e sbagliata: cerca il primo
     <section> fra i fratelli, e in questa pagina i primi <section> sono
     l'apertura e la biografia. Non corrispondeva a nulla. */
  .vetrina {
    border-top: 1px solid var(--border);
  }

  .vetrina + .vetrina {
    border-top: none;
  }

  /* La fotografia cambia lato a ogni blocco. Solo dove ci sono due colonne:
     sotto, l'ordine e' sempre fotografia e poi testo. */
  @media (min-width: 900px) {
    .vetrina[data-lato='foto-dopo'] .vetrina-foto {
      order: 2;
    }
  }

  .vetrina-griglia {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  /* La fotografia si vede INTERA, senza ritaglio.
     Prima riempiva una fascia a tutta pagina con object-fit: cover, e su una
     foto verticale il ritaglio centrale lasciava fuori il coltello: restava
     il piano d'appoggio. Non si puo' sapere dove sta la lama in ogni
     fotografia che Alessandro caricera' in futuro, quindi non si indovina:
     si mostra tutto. */
  /* :global perche' l'<img> lo produce FotoColtello e porta l'ambito di QUEL
     componente, non di questo: una regola normale non lo raggiunge. Senza
     questo, height:auto non si applicava, l'attributo height dell'immagine
     (4284) diventava un'altezza CSS e la fotografia veniva resa alta 4284px,
     tagliata dal contenitore. E' la trappola numero due di
     docs/TRAPPOLE.md, ripresa in pieno. */
  :global(.vetrina-immagine) {
    width: 100%;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .vetrina-etichetta {
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1rem;
  }

  .vetrina-nome {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1.2rem;
  }

  .vetrina-riga {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
    margin: 0 0 2.2rem;
    max-width: 34rem;
  }

  .vetrina-azione {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* Due colonne solo quando c'e' spazio davvero: sotto, la fotografia sta
     sopra e il testo sotto, che e' l'ordine in cui si guarda un oggetto. */
  @media (min-width: 900px) {
    .vetrina-griglia {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .vetrina {
      padding: 4rem 1.5rem;
    }

    .vetrina-immagine {
      max-height: 62vh;
    }
  }

  /* ── LE INFORMAZIONI ARRIVANO DOPO LA FOTOGRAFIA ─────────
     Scorrendo, prima entra la fotografia; poi, sfalsate, l'etichetta, il
     nome, la riga di descrizione e il pulsante. Non e' decorazione: e'
     l'ordine in cui si guarda un oggetto fatto a mano — prima la cosa, poi
     come si chiama, poi cosa e'.

     Legato allo scorrimento e non a un timer: fermandosi a metà l'effetto sta
     a metà, e tornando su torna indietro. Le proprietà sono scritte per
     esteso, mai con la scorciatoia "animation": vedi docs/TRAPPOLE.md. */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .vetrina-foto,
      .vetrina-etichetta,
      .vetrina-nome,
      .vetrina-riga,
      .vetrina-azione {
        animation-timing-function: cubic-bezier(0.16, 0.84, 0.24, 1);
        animation-fill-mode: both;
        animation-timeline: view();
      }

      .vetrina-foto {
        animation-name: vetrinaFotografia;
        animation-range: entry 0% cover 20%;
      }

      .vetrina-etichetta {
        animation-name: vetrinaInformazione;
        animation-range: entry 16% cover 34%;
      }

      .vetrina-nome {
        animation-name: vetrinaInformazione;
        animation-range: entry 22% cover 40%;
      }

      .vetrina-riga {
        animation-name: vetrinaInformazione;
        animation-range: entry 28% cover 46%;
      }

      .vetrina-azione {
        animation-name: vetrinaInformazione;
        animation-range: entry 34% cover 52%;
      }
    }
  }

  @keyframes vetrinaFotografia {
    from {
      opacity: 0;
      transform: translateY(46px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes vetrinaInformazione {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
