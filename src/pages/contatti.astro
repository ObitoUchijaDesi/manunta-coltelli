---
import Base from '../layouts/Base.astro'
import {caricaImpostazioni} from '../lib/contenuti'
import {urlWhatsApp, urlEmail, urlInstagram, utenteInstagram, messaggi} from '../lib/contatti'

/**
 * Nessun modulo di contatto, per scelta.
 *
 * Un form richiederebbe un servizio esterno che riceve gli invii: un altro
 * account da intestare al proprietario, un'altra cosa che può smettere di
 * funzionare senza che nessuno se ne accorga, e dati di visitatori conservati
 * da qualche parte. Per far partire una conversazione bastano WhatsApp e una
 * email, che Alessandro ha già e che continueranno a funzionare da sole.
 *
 * L'indirizzo email è anche scritto in chiaro sotto il pulsante: chi usa la
 * posta dal browser e non ha un programma configurato può copiarlo, invece di
 * cliccare un link che non apre niente.
 */

const impostazioni = await caricaImpostazioni()

const whatsapp = urlWhatsApp(impostazioni, messaggi.generico)
const email = urlEmail(impostazioni, messaggi.oggettoEmail(), messaggi.corpoEmail())
const instagram = urlInstagram(impostazioni)
const nomeInstagram = utenteInstagram(impostazioni)

const nessunRecapito = !whatsapp && !email && !instagram
---

<Base
  titolo="Contatti"
  descrizione={`Contatta ${impostazioni.nomeArtigiano} per informazioni sui coltelli artigianali o per commissionarne uno su misura.`}
  impostazioni={impostazioni}
>
  <main id="contenuto-principale">
    <section class="contacts-wrap" aria-labelledby="titolo-contatti">
      <div class="divider divider-alto"><span aria-hidden="true">✦</span></div>
      <p class="s-label">Contatti</p>
      <h1 class="s-title" id="titolo-contatti">Parliamo di<br />un progetto</h1>

      <p class="contatti-intro">
        {
          impostazioni.invitoContatto ||
            'Ogni coltello nasce da una conversazione. Raccontami cosa hai in mente e realizzeremo insieme qualcosa di unico.'
        }
      </p>

      {
        nessunRecapito ? (
          <p class="contatti-mancanti">
            I recapiti non sono ancora stati inseriti nel pannello di gestione.
          </p>
        ) : (
          <div class="canali">
            {whatsapp && (
              <div class="canale canale-primario">
                <h2 class="canale-titolo">WhatsApp</h2>
                <p class="canale-nota">Il modo più veloce. Rispondo appena posso.</p>
                <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-gold canale-azione">
                  Scrivi su WhatsApp
                </a>
              </div>
            )}

            {email && (
              <div class="canale">
                <h2 class="canale-titolo">Email</h2>
                <p class="canale-nota">Se preferisci scrivere con calma, o non usi WhatsApp.</p>
                <a href={email} class="btn-ghost canale-azione">Scrivi una email</a>
                <p class="canale-indirizzo">
                  oppure copia l’indirizzo: <span class="indirizzo">{impostazioni.email}</span>
                </p>
              </div>
            )}

            {instagram && (
              <div class="canale">
                <h2 class="canale-titolo">Instagram</h2>
                <p class="canale-nota">Le lavorazioni in corso, giorno per giorno.</p>
                <a href={instagram} target="_blank" rel="noopener noreferrer" class="btn-ghost canale-azione">
                  @{nomeInstagram}
                </a>
              </div>
            )}
          </div>
        )
      }

      {
        impostazioni.localita && (
          <p class="contatti-luogo">
            La bottega è a <strong>{impostazioni.localita}</strong>.
          </p>
        )
      }

      <p class="contatti-privacy">
        Quello che scrivi arriva direttamente ad Alessandro tramite WhatsApp, email o Instagram:
        questo sito non raccoglie né conserva nulla. <a href="/privacy/">Come trattiamo i dati</a>.
      </p>
    </section>
  </main>
</Base>

<style>
  .divider-alto {
    margin-top: 1rem;
  }

  .contatti-intro {
    color: var(--muted);
    max-width: 55ch;
    margin-bottom: 3rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .canali {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .canale {
    background: var(--bg);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .canale-primario {
    background: var(--bg2);
  }

  .canale-titolo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--text);
    margin: 0;
  }

  .canale-nota {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0;
    max-width: 42ch;
  }

  .canale-azione {
    margin-top: 0.75rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .canale-indirizzo {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .indirizzo {
    color: var(--text);
    /* Selezionabile con un tocco prolungato sul telefono. */
    user-select: all;
    word-break: break-all;
  }

  .contatti-luogo {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .contatti-luogo strong {
    color: var(--text);
    font-weight: 400;
  }

  .contatti-mancanti {
    color: var(--muted);
    border: 1px solid var(--border2);
    padding: 1.25rem;
  }

  .contatti-privacy {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 60ch;
  }

  @media (min-width: 760px) {
    .canali {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>
