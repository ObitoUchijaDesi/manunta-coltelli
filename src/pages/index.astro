---
import Base from '../layouts/Base.astro'
import SchedaColtello from '../components/SchedaColtello.astro'
import VetrinaGrande from '../components/VetrinaGrande.astro'
import {caricaColtelli, caricaImpostazioni} from '../lib/contenuti'
import {urlWhatsApp, messaggi} from '../lib/contatti'

const impostazioni = await caricaImpostazioni()
const coltelli = await caricaColtelli()

// In home i primi sei: il catalogo completo ha la sua pagina.
const inEvidenza = coltelli.slice(0, 6)

const whatsapp = urlWhatsApp(impostazioni, messaggi.generico)

const descrizione =
  impostazioni.presentazioneBreve?.slice(0, 155) ||
  'Coltelli artigianali sardi forgiati a mano, uno a uno.'

const datiStrutturati: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${impostazioni.nomeArtigiano} Coltelli`,
  description: descrizione,
  url: Astro.site?.href,
  image: new URL('/logo.png', Astro.site).href,
  knowsAbout: ['coltelli artigianali', 'coltelleria sarda', 'resolza', 'forgiatura'],
}

// Solo campi verificabili: niente prezzi inventati, niente indirizzo finto.
if (impostazioni.localita) {
  datiStrutturati.address = {
    '@type': 'PostalAddress',
    addressLocality: impostazioni.localita,
    addressCountry: 'IT',
  }
}
if (impostazioni.instagram) {
  datiStrutturati.sameAs = [`https://instagram.com/${impostazioni.instagram.replace(/^@/, '')}`]
}
---

<Base
  titolo="Alessandro Manunta Coltelli"
  descrizione={descrizione}
  impostazioni={impostazioni}
  datiStrutturati={datiStrutturati}
>
  <main id="contenuto-principale">
    <!-- ── APERTURA ── -->
    <section class="hero" aria-label="Presentazione">
      <div class="hero-inner">
        {/* Lo stesso logo della barra in alto, qui grande.
            width e height espliciti più height:auto nel CSS: senza, gli
            attributi diventano un'altezza fissa e l'immagine si stira — è il
            difetto che avevamo già trovato sulle fotografie dei coltelli. */}
        <img
          src="/logo.png"
          alt="Alessandro Manunta — Coltelli artigianali"
          width="590"
          height="660"
          class="hero-logo"
          loading="eager"
          fetchpriority="high"
        />
        {/* Una sola scritta grande, come ha chiesto Alessandro. Prima c'erano
            due righe sovrapposte — l'occhiello "Artigianato coltelliero sardo"
            e il titolo "Lame forgiate con anima" — che dicevano la stessa cosa
            in due modi. */}
        <h1 class="hero-h1">Maestro<br /><em>Coltellinaio</em></h1>
        {impostazioni.presentazioneBreve && <p class="hero-sub">{impostazioni.presentazioneBreve}</p>}
        <div class="hero-btns">
          <a href="/coltelli/" class="btn-gold">Guarda il catalogo</a>
          <a href="/contatti/" class="btn-ghost">Parliamo del progetto</a>
        </div>
      </div>
    </section>

    <!-- ── CHI SONO ── -->
    {
      impostazioni.biografia && (
        <section class="section section-dark" id="chi-sono" aria-labelledby="titolo-chi-sono">
          <div class="container">
            <div class="divider"><span aria-hidden="true">✦</span></div>
            <p class="s-label">Chi sono</p>
            <h2 class="s-title" id="titolo-chi-sono">Passione e<br />tradizione</h2>
            <p class="bio-text">{impostazioni.biografia}</p>
          </div>
        </section>
      )
    }

    <!-- ── UN COLTELLO GRANDE QUANTO LO SCHERMO ── -->
    {/* I primi coltelli secondo l'ordine scelto da Alessandro. Due e non tre:
        ogni blocco occupa quasi tutto lo schermo, e con tre la home diventa
        una salita prima di arrivare al catalogo. Per cambiarne il numero
        basta questa riga. */}
    {inEvidenza.length > 0 && <VetrinaGrande coltelli={inEvidenza.slice(0, 2)} />}

    <!-- ── CATALOGO IN EVIDENZA ── -->
    <section class="section" id="coltelli" aria-labelledby="titolo-coltelli">
      <div class="container">
        <div class="divider"><span aria-hidden="true">✦</span></div>
        <p class="s-label">Collezione</p>
        <h2 class="s-title" id="titolo-coltelli">Catalogo coltelli</h2>

        {
          inEvidenza.length === 0 ? (
            <p class="nessun-coltello">Il catalogo è in preparazione.</p>
          ) : (
            <>
              <div class="knives-grid">
                {inEvidenza.map((coltello, i) => (
                  <SchedaColtello
                    coltello={coltello}
                    impostazioni={impostazioni}
                    prioritaria={i < 2}
                  />
                ))}
              </div>

              {coltelli.length > inEvidenza.length && (
                <p class="vedi-tutti">
                  <a href="/coltelli/" class="btn-ghost">
                    Vedi tutti i {coltelli.length} coltelli
                  </a>
                </p>
              )}
            </>
          )
        }
      </div>
    </section>

    <!-- ── COME LAVORO ── -->
    {
      impostazioni.passaggiLavorazione.length > 0 && (
        <section class="section section-dark" aria-labelledby="titolo-processo">
          <div class="container">
            <div class="divider"><span aria-hidden="true">✦</span></div>
            <p class="s-label">Il processo</p>
            <h2 class="s-title" id="titolo-processo">Come lavoro</h2>
            <ol class="process-grid">
              {impostazioni.passaggiLavorazione.map((passaggio, i) => (
                <li class="process-step">
                  <span class="process-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="process-title">{passaggio.titolo}</h3>
                  <p class="process-body">{passaggio.testo}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <!-- ── INVITO AL CONTATTO ── -->
    <section class="section cta-section" aria-labelledby="titolo-contatto">
      <div class="container cta-inner">
        <div class="divider"><span aria-hidden="true">✦</span></div>
        <h2 class="s-title titolo-cta" id="titolo-contatto">
          Hai un progetto<br /><em class="cta-em">in mente?</em>
        </h2>
        {impostazioni.invitoContatto && <p class="cta-testo">{impostazioni.invitoContatto}</p>}
        <div class="hero-btns">
          {
            whatsapp && (
              <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-gold">
                Scrivimi su WhatsApp
              </a>
            )
          }
          <a href="/contatti/" class="btn-ghost">Vedi tutti i contatti</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero-logo {
    display: block;
    width: auto;
    height: clamp(90px, 16vw, 150px);
    margin: 0 auto 2rem;
    /* Un filo smorzato: il logo apre la pagina, ma il titolo resta il
       protagonista. A piena opacità si rubano la scena a vicenda. */
    opacity: 0.9;
  }

  .nessun-coltello {
    color: var(--muted);
    font-size: 0.95rem;
    padding-top: 1rem;
  }

  .vedi-tutti {
    margin-top: 3rem;
    text-align: center;
  }

  .titolo-cta {
    margin-bottom: 0.75rem;
  }

  .cta-em {
    font-style: italic;
    color: var(--gold);
  }

  .cta-testo {
    color: var(--muted);
    max-width: 480px;
    margin: 0 auto 2.25rem;
    font-size: 1rem;
    line-height: 1.75;
  }
</style>
