# Configurazione del pannello di gestione (Sanity Studio).
# Copia questo file in "studio/.env" e compila i valori.
#
# Nessuno dei due valori qui sotto è un segreto: finiscono nel codice del
# pannello e sono pubblici per come è fatto Sanity. I veri segreti (i token con
# permesso di scrittura) non vanno MAI in un file .env committabile: stanno solo
# nelle impostazioni di GitHub Actions e di Cloudflare Pages.
#
# Il prefisso SANITY_STUDIO_ è obbligatorio: senza, Sanity non le legge.

# Identificativo del progetto, da sanity.io/manage
SANITY_STUDIO_PROJECT_ID=

# Quasi sempre "production"
SANITY_STUDIO_DATASET=production
